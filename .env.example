# Copy this file to `.env` and fill in your own values, OR set these
# as real environment variables before running `python app.py`.
# (Phase 1 uses plain os.environ; a loader like python-dotenv can be
# added later if you prefer using a real .env file.)

SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=True

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Root@123
MYSQL_DATABASE=academic_scheduler

TOKEN_EXPIRY_HOURS=12